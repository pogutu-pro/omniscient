# =============================================================================
# Omniscient — environment configuration template
# Copy to .env and fill in real values. Never commit the actual .env file.
# =============================================================================

# --- Application ---
APP_ENV=development                 # development | staging | production
APP_URL=http://localhost:5173
API_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string   # used to sign JWTs
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Matched in ADDITION to CORS_ORIGINS. Optional. Useful for a host like
# Vercel that mints a new preview URL per branch/PR, so you don't have to
# add each one to CORS_ORIGINS by hand:
# CORS_ORIGIN_REGEX=^https://omniscient(-[a-z0-9-]+)?\.vercel\.app$
CORS_ORIGIN_REGEX=

# --- Database ---
# Local Postgres (docker compose / local dev):
DATABASE_URL=postgresql+asyncpg://omniscient:omniscient@localhost:5432/omniscient
DATABASE_URL_SYNC=postgresql+psycopg2://omniscient:omniscient@localhost:5432/omniscient
DATABASE_SSL=false
#
# Neon (or any managed Postgres that requires TLS) - use Neon's pooled
# connection string for both; asyncpg's statement cache is already
# disabled in code so it's safe against Neon's pgbouncer-style pooler:
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<db>
# DATABASE_URL_SYNC=postgresql+psycopg2://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# DATABASE_SSL=true

# --- AI provider abstraction ---
# LLM_PROVIDER=mock uses a deterministic, offline provider so the whole
# product works without any external API key. Every other option speaks
# through the same LLMProvider interface (agents/providers/base.py), so
# switching providers — including moving to a sixth one later — is only
# ever a config change, never an application code change.
#
#   mock      - deterministic, offline, no key needed (default)
#   grok      - xAI Grok. Intended primary real provider.
#   deepseek  - DeepSeek.
#   openai    - OpenAI.
#   anthropic - Claude, via the native Anthropic SDK.
#   custom    - any other OpenAI-compatible endpoint (Groq, Together,
#               Mistral, a self-hosted vLLM/Ollama server, ...).
#               LLM_API_BASE is required for this one.
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5           # e.g. grok-4-latest, deepseek-chat, gpt-4.1 - check the provider's docs for current model ids
LLM_API_KEY=
LLM_API_BASE=                       # only required when LLM_PROVIDER=custom; optional override otherwise
LLM_TEMPERATURE=0.2

# --- Rumia integration boundary ---
# Omniscient never shares Rumia's database or writes into it. This build
# ships with RUMIA_DB_MODE=disabled, which makes every domain repository
# use the Mock* implementation seeded with local demo data. Flipping this
# to "enabled" later (with a read-only, listings-only connection string)
# switches housing lookups to RumiaPostgresHostelRepository without any
# code changes elsewhere in the app.
RUMIA_DB_MODE=disabled              # disabled | enabled
RUMIA_DATABASE_URL=                 # read-only, listings-only connection string

# --- File storage (past papers, complaint attachments) ---
STORAGE_PROVIDER=local              # local | s3
STORAGE_LOCAL_PATH=./backend/var/storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# --- Rate limiting ---
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# --- Frontend (Vite exposes only VITE_ prefixed vars to the browser) ---
VITE_API_URL=http://localhost:8000
