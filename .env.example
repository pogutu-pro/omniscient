# =============================================================================
# Omniscient — environment configuration
#
#   cp .env.example .env    then fill in part 3
#
# On the production VM this file is created once by an operator and is never
# read, written, or logged by CI. The deploy pipeline pulls image tags only.
#
# THE FILE IS IN THREE PARTS:
#
#   1. FINISHED   Values that are already correct for production. Nothing to
#                 do. Leave them alone unless you are deliberately changing
#                 that setting.
#   2. OPTIONAL   Decisions nobody has made yet, and settings for features
#                 not in use. Safe to leave as-is.
#   3. FILL IN    Required secrets and credentials. Every REPLACE_ME must be
#                 replaced; the app refuses to start in production while any
#                 remain. Kept at the bottom so the complete list of what you
#                 must supply is in one place.
# =============================================================================


# #############################################################################
# 1. FINISHED — already correct, nothing to do
# #############################################################################

# --- Application identity ---
# The SPA is served from the same origin as the API, so the only origin
# that needs allowing is the site's own.
APP_ENV=production
APP_URL=https://omniscient.co.ke
API_URL=https://omniscient.co.ke
CORS_ORIGINS=https://omniscient.co.ke,https://www.omniscient.co.ke

# --- Database identity ---
# The password, and the connection URLs that embed it, are in part 3.
POSTGRES_USER=omniscient
POSTGRES_DB=omniscient

# --- AI provider: DeepSeek (primary) ---
# The API key is in part 3.
# Valid ids: deepseek-flash, deepseek-v4-pro (verify via GET /models).
# `deepseek-chat` and `deepseek-reasoner` were retired on 2026-07-24.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash

# --- AI provider: Groq (fallback) ---
# The API key is in part 3.
# When DeepSeek returns 429, errors, or a malformed reply, the turn is
# transparently retried here and the execution trace names whichever
# provider actually answered. Set LLM_FALLBACK_PROVIDER= (empty) to
# disable failover entirely.
#
# Do NOT use llama-3.3-70b-versatile: Groq shut it down on 2026-08-16, and
# it was Enterprise-tier so never on the free plan. openai/gpt-oss-20b is
# the current production-tier default, on the free plan (250K TPM / 1K
# RPM), ~1000 tokens/sec, $0.075 in / $0.30 out per 1M tokens.
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# --- File storage: Cloudflare R2 ---
# Past papers and complaint attachments live in R2, not on the VM, so a
# redeploy cannot lose them and they consume no block volume. The R2
# credentials and bucket are in part 3.
STORAGE_PROVIDER=s3

# --- Retrieval ---
# Both must be true, and the app refuses to start otherwise: retrieval
# embeds the question first, and it grounds answers in retrieved text, so
# without a real provider it could only ever return nothing.
EMBEDDING_ENABLED=true
RAG_ENABLED=true

# --- Application defaults ---
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Where dotenv values are read from, relative to the process working
# directory. The test suite sets this empty to switch dotenv loading off
# entirely, which it must do because backend/.env is a symlink to the
# repo-root .env.
OMNISCIENT_ENV_FILE=.env

# --- Database defaults ---
# Only ever true for a managed Postgres that requires TLS (Neon, Supabase,
# RDS). The in-VM container is on a private compose network and is not
# TLS-wrapped.
DATABASE_SSL=false

# --- AI provider defaults ---
# Only read for LLM_PROVIDER=custom, which is not in use.
LLM_API_BASE=
LLM_TEMPERATURE=0.2
# Only read for a fallback whose provider is `custom`.
LLM_FALLBACK_API_BASE=

# --- Embeddings ---
# Self-hosted, so there is no third API key and no third party who can
# fail. Inference runs in the backend process via ONNX, off the event loop,
# and the model is baked into the image at build time so nothing is
# downloaded at runtime.
#
# DeepSeek and Groq do not serve an embeddings API, which is why this is
# separate from the LLM settings above.
#
# local = in-process ONNX, no extra container and no PyTorch.
# tei   = a Text Embedding Inference sidecar, for when one box stops being
#         enough. Only then is EMBEDDING_BASE_URL used.
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# MUST match the vector column width in the migration. Changing it requires
# a migration that resizes the column AND a full re-embed of every stored
# chunk; doing one without the other makes search return nonsense silently.
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=60

# --- Past-paper retrieval tuning ---
RAG_TOP_K=6
# Cosine similarity floor. Below this the match is noise and the model is
# better off saying it found nothing than quoting something irrelevant.
RAG_MIN_SCORE=0.25
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=150

# --- R2 addressing ---
# R2's region is the literal string "auto".
S3_REGION=auto
# Must be "path" for R2. boto3 defaults to virtual-host style
# (bucket.endpoint), which R2 does not answer, and the resulting error
# mentions DNS rather than anything about the bucket.
S3_ADDRESSING_STYLE=path
# Only for local development. Relative to the process working directory:
# correct from the repo root on a laptop, wrong inside the backend
# container, where it is /app/var/storage. Both compose files set it
# explicitly, so this only matters when running uvicorn by hand.
STORAGE_LOCAL_PATH=./backend/var/storage

# --- Rate limiting ---
# In-process and therefore per-container. Correct for a single backend
# instance; move it to Redis before adding a second replica, or each will
# enforce the limit independently and the effective cap doubles.
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# --- Images (used by docker-compose.yml interpolation) ---
# The deploy workflow overrides these per release. These defaults are for a
# manual `docker compose up` on the VM.
BACKEND_IMAGE=ghcr.io/pogutu-pro/omniscient-backend:latest
FRONTEND_IMAGE=ghcr.io/pogutu-pro/omniscient-frontend:latest

# --- Frontend ---
# Vite inlines import.meta.env.* into the bundle, so this is fixed at build
# time and there is no runtime override for a static SPA build.
VITE_API_URL=https://omniscient.co.ke


# #############################################################################
# 2. OPTIONAL — no decision made yet; safe to leave as-is
# #############################################################################

# --- OPEN: complaint attachments have no access control ---
#
# `url_for()` returns an UNSIGNED url, so a single public R2 bucket makes
# every complaint attachment world-readable to anyone holding the link.
# Past papers are fine public. Student complaints are not.
#
# Three options, in order of preference:
#
#   1. Add presigned-URL support before taking real complaints. Roughly a
#      day: sign get_object with an expiry in S3StorageBackend and stop
#      returning bare urls. Best fix, and it does not affect RAG.
#   2. Keep STORAGE_PROVIDER=local for now. Attachments live on the VM and
#      are served only through authenticated API routes. Cost: lost if the
#      VM is replaced, and they consume block volume.
#   3. One public bucket, accepting that complaints are public until (1)
#      is done. Only reasonable while testing with no real complaints.
#
# The storage block above already assumes option 3's layout. Changing this
# decision means editing S3_* in part 3 too.
# DECIDED: no

# --- OPEN: the TEI sidecar does not exist ---
# Only consulted when EMBEDDING_BACKEND=tei. There is no `tei` service in
# docker-compose.yml, so switching the backend without adding one gives an
# embedding service that is never reachable.
# EMBEDDING_BASE_URL=http://tei:8080

# --- OPEN: Rumia housing feed ---
# Omniscient never shares Rumia's database, never writes into it, and never
# holds a credential for it. Housing is read over Rumia's own public,
# unauthenticated HTTP API.
#
# disabled (below) = every domain repository uses the Mock implementation
# with seeded local demo data and makes no outbound calls at all. This is
# the default and is what production should use until Rumia is ready.
# enabled           = point the hostel repository at Rumia's listings API.
# No application code changes either way.
RUMIA_DB_MODE=disabled              # disabled | enabled
RUMIA_API_BASE_URL=https://rumia.co.ke/api/v1
RUMIA_CAMPUS_SLUG=dekut             # Rumia is campus-scoped; this app is DeKUT-only
RUMIA_TIMEOUT_SECONDS=10
RUMIA_CACHE_TTL_SECONDS=60          # 0 disables caching
# Rumia's API does not expose a `verified` flag, because Rumia does not
# publish one: every listing live on Rumia has been through Rumia's own
# vetting. Treating is_active=true as verified is therefore an assertion
# about Rumia's process, which is why it is a switch. Set false and nothing
# is claimed that we cannot see, and a verified_only search returns nothing
# rather than passing off unvetted listings as verified.
RUMIA_TREAT_ACTIVE_AS_VERIFIED=true
# Reserved for a future direct-Postgres transport, intentionally not
# implemented. Never point this at a credential that can write, and never
# at a superuser: the HTTP transport above needs no credentials at all.
RUMIA_DATABASE_URL=

# --- OPEN: Vercel preview deploys ---
# Matched in ADDITION to CORS_ORIGINS, so a host that mints a new preview
# URL per branch does not need each one added by hand. Only relevant if the
# frontend is hosted on Vercel; the primary deployment serves SPA and API
# from one origin and needs nothing here.
# CORS_ORIGIN_REGEX=^https://omniscient(-[a-z0-9-]+)?\.vercel\.app$
CORS_ORIGIN_REGEX=


# #############################################################################
# 3. FILL IN — required; every REPLACE_ME must be replaced
# #############################################################################

# --- Signing key ---
# Signs JWTs. Generate with: openssl rand -hex 32
# Rotating this logs every student out, so it cannot be rotated casually.
# NOT RECOVERABLE: this exists nowhere but this file and your password
# manager. If you lose the VM without a copy, every session is invalidated
# and you must reissue.
SECRET_KEY=REPLACE_ME_openssl_rand_hex_32

# --- Database password and connection URLs ---
# The password below is also embedded in DATABASE_URL/_SYNC. Compose
# overrides all three with the correct `db` service address, so the URLs
# only matter for a non-compose run (psql, the CLI). Keep them consistent.
POSTGRES_PASSWORD=REPLACE_ME_strong_random_password
DATABASE_URL=postgresql+asyncpg://omniscient:REPLACE_ME_strong_random_password@db:5432/omniscient
DATABASE_URL_SYNC=postgresql+psycopg2://omniscient:REPLACE_ME_strong_random_password@db:5432/omniscient

# --- AI provider: DeepSeek key ---
# DeepSeek's API is prepaid. A key with a zero balance authenticates
# successfully and then fails every request, which presents as a broken
# deployment rather than as a billing problem. Add credit at
# https://platform.deepseek.com before assuming the key is at fault.
LLM_API_KEY=REPLACE_ME_deepseek_api_key

# --- AI provider: Groq fallback key ---
# The free developer plan is enough.
LLM_FALLBACK_API_KEY=REPLACE_ME_groq_api_key

# --- File storage: Cloudflare R2 credentials ---
# API endpoint, from the R2 dashboard. Not the public URL.
S3_ENDPOINT=REPLACE_ME_https_accountid_r2_cloudflarestorage_com
S3_BUCKET=REPLACE_ME_bucket_name
S3_ACCESS_KEY=REPLACE_ME_r2_access_key_id
S3_SECRET_KEY=REPLACE_ME_r2_secret_access_key
# The public base URL a browser is sent to — the custom domain attached to
# the bucket in Cloudflare. Deliberately separate from S3_ENDPOINT, which
# is a private credentialed address.
S3_PUBLIC_URL=REPLACE_ME_https_files_omniscient_co_ke

# --- TLS ---
# Let's Encrypt account contact. Expiry notices go here.
ACME_EMAIL=REPLACE_ME_your_email_address
